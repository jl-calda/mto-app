# ── Supabase (server-side repository) ───────────────────────────────────────
# The app uses the in-memory seed until BOTH of the first two are set, then it
# switches to the Supabase repository automatically (see lib/repo/index.ts).
SUPABASE_URL=https://kzprzimqdhqnttkvdxpb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # service_role secret (Dashboard → Project Settings → API). NEVER commit.

# Publishable key — safe for the browser / future Supabase Auth + client use.
NEXT_PUBLIC_SUPABASE_URL=https://kzprzimqdhqnttkvdxpb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_vuf1D9O7oeXzQKVJGeL9Jw_pWbiKk7p

# ── One-time seed load ──────────────────────────────────────────────────────
# After setting the service-role key, POST /api/seed with this token to upsert
# the seed into Supabase:  curl -X POST $APP_URL/api/seed -H "x-seed-token: $SEED_TOKEN"
SEED_TOKEN=
